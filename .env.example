# Copiar para .env e preencher. NUNCA fazer commit do .env (está no .gitignore).
# chmod 600 .env

# Postgres (leitura do plano + escrita de validados em mes_kanban)
MES_PG_HOST=127.0.0.1
MES_PG_PORT=5432
MES_PG_DB=dataresearchmtg
MES_PG_USER=mes_kanban_app
MES_PG_PASSWORD=

# OCR via Claude API (visão). Sem chave, o upload fica em fila com erro claro.
ANTHROPIC_API_KEY=
MES_OCR_MODEL=claude-sonnet-5

# Web
MES_HOST=127.0.0.1
MES_PORT=8000
MES_ADMIN_TOKEN=
